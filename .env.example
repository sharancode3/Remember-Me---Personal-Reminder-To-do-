# ==============================================================================
# REMEMBER ME — ENVIRONMENT & API CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Remember Me is a LOCAL-FIRST application. All core features (scheduling,
# routines, focus mode, Isar database, reality mode, offline notifications,
# journey vector radar, and statistical duration learning) work 100% offline
# without any API keys or internet connection.
#
# Only configure the variables below if you are enabling external cloud enhancements.
# ==============================================================================

# [OPTIONAL] Maps & Geocoding Provider (e.g., Google Maps Platform or Mapbox)
# Required only if replacing the local vector canvas with third-party satellite raster tiles
MAPS_API_KEY=
ROUTES_API_KEY=
GEOCODING_API_KEY=
PLACES_API_KEY=

# [OPTIONAL] Weather API Key
# Default: Remember Me uses Open-Meteo (zero-key, free, rate-limited, cached locally).
# Only populate if routing through a commercial weather vendor like Tomorrow.io or AccuWeather.
WEATHER_API_KEY=

# [OPTIONAL] Cloud AI & Natural Language Decomposition (e.g., Gemini or OpenAI)
# Used exclusively for natural-language multi-day constraint decomposition.
AI_API_KEY=

# [OPTIONAL] Telemetry & Crash Reporting (e.g., Sentry)
SENTRY_DSN=
